<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Qtx.Cli</RootNamespace>
    <AssemblyName>qtx</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../encoder/Qtx.Encoder/Qtx.Encoder.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../dist/windows/x86_64/qtx_decoder.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))" CopyToOutputDirectory="PreserveNewest" Link="qtx_decoder.dll" />
    <None Include="../../dist/linux/x86_64/libqtx_decoder.so" Condition="$([MSBuild]::IsOSPlatform('Linux'))" CopyToOutputDirectory="PreserveNewest" Link="libqtx_decoder.so" />
    <None Include="../../dist/macos/libqtx_decoder.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))" CopyToOutputDirectory="PreserveNewest" Link="libqtx_decoder.dylib" />
  </ItemGroup>
</Project>
